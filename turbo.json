{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["fixtures", "ts", "tsdown.config.*", "tsconfig.*", "package.json"],
			"outputs": ["cjs/**", "esm/**"]
		},
		"clean": {
			"cache": false
		},
		"coverage": {
			"dependsOn": ["build"],
			"inputs": ["fixtures", "ts", "vitest.config.*", "tsconfig.*", "package.json"],
			"outputs": ["coverage/**"]
		},
		"depcheck": {
			"dependsOn": ["build"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"nuke": {
			"cache": false
		},
		"size": {
			"dependsOn": ["build"],
			"inputs": ["fixtures", "ts", ".size-limit.*", "tsconfig.*", "package.json"]
		},
		"test": {
			"dependsOn": ["build"],
			"inputs": ["fixtures", "ts", "vitest.config.*", "tsconfig.*", "package.json"]
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"inputs": ["ts", "tsconfig.*", "tsdown.config.*", "vitest.config.*", "package.json"]
		}
	}
}
