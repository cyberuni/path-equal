{
	"name": "uni-path",
	"version": "0.0.0",
	"private": true,
	"description": "Universal path module",
	"homepage": "https://github.com/cyberuni/path-equal",
	"bugs": {
		"url": "https://github.com/cyberuni/path-equal/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/path-equal.git",
		"directory": "packages/uni-path"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		"types": "./esm/index.d.ts",
		"import": "./esm/index.js"
	},
	"types": "./esm/index.d.ts",
	"files": [
		"esm",
		"ts",
		"!**/*.{spec,test,unit,accept,integrate,system}.*"
	],
	"scripts": {
		"build": "run-p build:esm",
		"build:esm": "tsc",
		"clean": "rimraf coverage esm *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"dev": "vitest",
		"nuke": "pnpm clean && rimraf node_modules",
		"size": "size-limit",
		"test:watch": "vitest",
		"test": "vitest run",
		"verify": "npm-run-all -p build depcheck coverage -p size"
	},
	"dependencies": {
		"path-equal": "workspace:^"
	},
	"devDependencies": {
		"@size-limit/preset-small-lib": "^13.0.0",
		"@types/node": "^24.0.0",
		"@vitest/coverage-v8": "^4.1.11",
		"depcheck": "^1.4.3",
		"npm-run-all2": "^9.0.0",
		"rimraf": "^6.0.0",
		"size-limit": "^13.0.0",
		"typescript": "^5.0.0",
		"vitest": "^4.1.11"
	}
}
