{
	"name": "path-equal",
	"version": "1.2.5",
	"description": "Determine two file paths are equal",
	"homepage": "https://github.com/cyberuni/path-equal",
	"bugs": {
		"url": "https://github.com/cyberuni/path-equal/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/path-equal.git",
		"directory": "packages/path-equal"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		"types": "./esm/index.d.ts",
		"import": "./esm/index.js",
		"default": "./cjs/index.js"
	},
	"main": "./cjs/index.js",
	"types": "./esm/index.d.ts",
	"files": [
		"cjs",
		"esm",
		"ts",
		"!**/*.{spec,test,unit,accept,integrate,system}.*"
	],
	"scripts": {
		"build": "run-p build:cjs build:esm",
		"build:cjs": "tsc -p tsconfig.cjs.json && ncp ../../config/package.cjs.json cjs/package.json",
		"build:esm": "tsc -p tsconfig.node16.json",
		"clean": "rimraf cjs coverage esm *.tsbuildinfo",
		"coverage": "jest --coverage --maxWorkers=60%",
		"cs": "changeset",
		"depcheck": "depcheck",
		"dev": "jest --watch",
		"nuke": "pnpm clean && rimraf node_modules",
		"publish:jsr": "pnpm dlx jsr publish",
		"size": "size-limit",
		"test:watch": "jest --watch",
		"test": "jest",
		"verify": "npm-run-all -p build depcheck lint coverage -p size"
	},
	"devDependencies": {
		"@jest/globals": "^30.2.0",
		"@repobuddy/jest": "^5.0.0",
		"@size-limit/preset-small-lib": "^13.0.0",
		"@types/node": "^24.12.4",
		"depcheck": "^1.4.3",
		"jest": "^30.2.0",
		"jest-watch-suspend": "^1.1.2",
		"jest-watch-toggle-config-2": "^2.1.0",
		"jest-watch-typeahead": "^3.0.1",
		"ncp": "^2.0.0",
		"npm-run-all2": "^9.0.0",
		"rimraf": "^6.0.1",
		"size-limit": "^13.0.0",
		"ts-jest": "^29.0.5",
		"typescript": "^5.0.2"
	}
}
