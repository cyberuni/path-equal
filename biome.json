{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"extends": ["@repobuddy/biome/recommended"],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"!**/.astro",
			"!packages/*/.turbo",
			"!packages/*/cjs",
			"!packages/*/coverage",
			"!packages/*/esm",
			"!skills-lock.json"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
