{
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"build:doc": "typedoc --plugin typedoc-plugin-extras",
		"check": "biome check .",
		"clean": "turbo run clean",
		"coverage": "turbo run coverage",
		"cs": "changeset",
		"depcheck": "turbo run depcheck",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"nuke": "pnpm --no-bail --filter=* nuke && pnpm --no-bail nuke:local",
		"nuke:local": "rimraf node_modules",
		"path-equal": "pnpm --filter path-equal",
		"prepare": "husky",
		"release": "pnpm build && changeset publish",
		"size": "turbo run size",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"verify": "biome ci . && turbo run build typecheck coverage depcheck size",
		"version": "changeset version"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@changesets/cli": "^3.0.1",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"rimraf": "^6.1.3",
		"turbo": "^2.10.12",
		"typedoc": "^0.28.20",
		"typedoc-plugin-extras": "^4.0.1",
		"typescript": "^5.9.3"
	},
	"packageManager": "pnpm@11.25.0"
}
